{
  "manifest_version": 3,
  "name": "Stoic YouTube",
  "description": "Make YouTube more intentional by removing Shorts from the web experience.",
  "version": "0.1.0",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Stoic YouTube",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/filters/index.js",
        "src/filters/shorts.js",
        "src/filters/home.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "stoic-youtube@example.com",
      "strict_min_version": "109.0"
    }
  }
}
